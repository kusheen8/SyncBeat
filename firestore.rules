rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100;
    }

    function isValidRoom(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.code is string && data.code.size() <= 20 &&
             data.hostId is string;
    }

    function isValidMessage(data) {
      return data.userId == request.auth.uid &&
             data.text is string && data.text.size() <= 1000;
    }

    function isValidQueueItem(data) {
      return data.addedBy == request.auth.uid &&
             data.songId is string;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isOwner(userId);
    }

    match /songs/{songId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // Allow seeding
    }

    match /rooms/{roomId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && isOwner(resource.data.hostId);

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
      }

      match /queue/{queueId} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn();
      }
    }

    match /users/{userId}/favorites/{songId} {
      allow read, write: if isOwner(userId);
    }
  }
}
