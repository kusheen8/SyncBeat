rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName']) &&
             data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 50;
    }

    function isValidRoom(data) {
      return data.keys().hasAll(['name', 'code', 'hostId']) &&
             data.name is string && data.name.size() <= 100 &&
             data.code is string && data.code.size() <= 20 &&
             data.hostId == request.auth.uid; // Only host can create/update their rooms
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['roomId', 'userId', 'text', 'username', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.text is string && data.text.size() <= 1000;
    }

    function isValidQueueItem(data) {
      return data.keys().hasAll(['roomId', 'songId', 'addedBy', 'addedByName', 'createdAt']) &&
             data.addedBy == request.auth.uid &&
             data.songId is string && data.songId.size() <= 128;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidUser(incoming());
    }

    match /songs/{songId} {
      allow get, list: if isSignedIn();
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidRoom(incoming());
      allow update: if isSignedIn() && (
        // Host updating playback or settings
        (isOwner(existing().hostId) && isValidRoom(incoming())) ||
        // Anyone updating members count (simplified for logic)
        (incoming().diff(existing()).affectedKeys().hasOnly(['membersCount', 'updatedAt']))
      );
      allow delete: if isSignedIn() && isOwner(existing().hostId);

      match /messages/{messageId} {
        allow list: if isSignedIn();
        allow create: if isSignedIn() && isValidMessage(incoming());
      }

      match /queue/{queueId} {
        allow list: if isSignedIn();
        allow create: if isSignedIn() && isValidQueueItem(incoming());
        allow delete: if isSignedIn() && (isOwner(existing().addedBy) || isOwner(get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId));
      }
    }

    match /users/{userId}/favorites/{songId} {
      allow read, write: if isOwner(userId);
    }
  }
}
